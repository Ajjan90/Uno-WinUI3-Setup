<Page
    x:Class="WinuiUno.Presentation.Pages.Audio1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinuiUno.Presentation.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <NavigationView
        x:Name="SettingsNavigation"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        OpenPaneLength="280">

        <NavigationView.PaneHeader>
            <StackPanel Spacing="12" Padding="12,16">
                <TextBlock
                    Text="Settings"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Margin="8,0,0,0"/>

                <AutoSuggestBox
                    PlaceholderText="Find a setting"
                    QueryIcon="Find"/>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="System" Tag="System">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="ContactInfo"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Bluetooth &amp; devices"
                                Tag="Bluetooth">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="BlockContact"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Network &amp; internet"
                                Tag="Network">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="World"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Personalisation"
                                Tag="Personalisation">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Comment"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Apps" Tag="Apps">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AllApps"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Accounts" Tag="Accounts">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Windows Update"
                                Tag="Update">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AttachCamera"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="32">
            <ScrollViewer>
                <StackPanel Spacing="24">

                    <TextBlock
                        x:Name="PageTitle"
                        Text="System"
                        FontSize="32"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Manage your device settings."
                        Opacity="0.7"
                        FontSize="14"/>

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Display"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <SymbolIcon
                                    Symbol="Mail"
                                    Grid.Column="0"/>

                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                    <TextBlock
                                        Text="Display settings"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Brightness, resolution and scaling"
                                        Opacity="0.7"
                                        FontSize="12"/>
                                </StackPanel>

                                <FontIcon
                                    Grid.Column="2"
                                    Glyph="&#xE76C;"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
